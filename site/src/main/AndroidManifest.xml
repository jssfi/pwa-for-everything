<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The label is a literal (not a resource) so the generator can patch it in the manifest's string pool. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/site_launcher"
        android:label="${siteLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pwa.Site">

        <activity
            android:name="fi.jss.pwa.WebAppActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
