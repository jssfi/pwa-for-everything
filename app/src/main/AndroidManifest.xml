<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installs and uninstalls the generated per-site apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Lets the app see the per-site apps it installed (to offer Open / Update / Uninstall). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pwa">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a page from Chrome to add it as an app. -->
            <intent-filter android:label="@string/share_add">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- One recents entry per site: each site gets its own task, keyed by the intent data URI. -->
        <activity
            android:name="fi.jss.pwa.WebAppActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Pwa.WebApp"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
